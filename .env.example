# ====================================================
# StudySpark - Environment Configuration Example
# ====================================================

# Server Port
PORT=5000

# AI Provider options: "gemini" | "groq" | "openai" | "mock"
# Default is "gemini" if AI_API_KEY is provided.
# If AI_API_KEY is not set or AI_PROVIDER="mock", the server gracefully uses
# the built-in intelligent educational mock engine for instant testing.
AI_PROVIDER=gemini

# Your API Key for the chosen provider:
# - Gemini: https://aistudio.google.com/app/apikey (Free tier available)
# - Groq: https://console.groq.com/keys (Fast, free tier available)
# - OpenAI: https://platform.openai.com/api-keys
AI_API_KEY=your_api_key_here

# Model identifier (optional, sensible defaults will be used if omitted)
# - For Gemini: gemini-1.5-flash (recommended) or gemini-1.5-pro
# - For Groq: llama-3.3-70b-versatile or llama3-8b-8192
# - For OpenAI: gpt-4o-mini or gpt-4o
AI_MODEL=gemini-1.5-flash

# Client URL for CORS whitelist (comma-separated if multiple)
CLIENT_URL=http://localhost:5173

